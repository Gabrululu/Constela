{
  "name": "constela",
  "version": "0.1.0",
  "private": true,
  "description": "IDE de Stellar en el navegador para principiantes y talleres en Latinoamérica (ES y PT-BR).",
  "license": "MIT",
  "packageManager": "pnpm@10.6.3",
  "scripts": {
    "templates": "node scripts/build-templates.mjs",
    "dev": "pnpm --filter web dev",
    "dev:compiler": "pnpm --filter compiler dev",
    "build": "pnpm --filter web build",
    "test": "pnpm --filter web test && pnpm --filter compiler test",
    "compiler:image": "docker build -t constela/soroban-sandbox:30.0.1 compiler/sandbox",
    "test:contracts": "node scripts/test-contracts.mjs"
  },
  "engines": { "node": ">=22.18" }
}
